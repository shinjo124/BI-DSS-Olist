                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[STA_OnlineRetail]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CAST(x.[OrderKey] AS int) AS [OrderKey],CAST(x.[OrderItemID] AS int) AS [OrderItemID],CAST(x.[DateKey] AS int) AS [DateKey],CAST(x.[CustomerKey] AS int) AS [CustomerKey],CAST(x.[ProductKey] AS int) AS [ProductKey],CAST(x.[SellerKey] AS int) AS [SellerKey],CAST(x.[Quantity] AS int) AS [Quantity],CAST(x.[Price] AS decimal(19,2)) AS [Price],CAST(x.[FreightValue] AS decimal(19,2)) AS [FreightValue] FROM (SELECT od.OrderKey,i.order_item_id,CONVERT(int,CONVERT(char(8),o.order_purchase_timestamp,112)),c.CustomerKey,p.ProductKey,s.SellerKey,1,i.price,i.freight_value
        FROM (SELECT o0.* FROM stg.Orders o0 WHERE o0.order_status NOT IN ('canceled','unavailable') AND EXISTS (SELECT 1 FROM stg.OrderItems i0 WHERE i0.order_id=o0.order_id)) o JOIN stg.OrderItems i ON i.order_id=o.order_id JOIN dbo.DimOrder od ON od.OrderID=o.order_id
        JOIN dbo.DimCustomer c ON c.CustomerID=o.customer_id JOIN dbo.DimProduct p ON p.ProductID=i.product_id JOIN dbo.DimSeller s ON s.SellerID=i.seller_id) AS x([OrderKey],[OrderItemID],[DateKey],[CustomerKey],[ProductKey],[SellerKey],[Quantity],[Price],[FreightValue])</property>
