    <DTS:Executable
      DTS:refId="Package\Prepare Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Prepare Staging"
      DTS:DTSID="{0472015E-F005-4D46-8BC0-E4B0089069CD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Prepare Staging"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{ACA3039B-930B-405B-9C38-1594EC75729F}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON; DELETE FROM stg.[Reviews]; DELETE FROM stg.[Payments]; DELETE FROM stg.[OrderItems]; DELETE FROM stg.[Orders]; DELETE FROM stg.[Customers]; DELETE FROM stg.[Products]; DELETE FROM stg.[CategoryTranslation]; DELETE FROM stg.[Sellers]; " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Validate Staging and Prepare Warehouse"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Validate Staging and Prepare Warehouse"
      DTS:DTSID="{9CD025AB-6315-478F-A566-6FE33CCBD5AB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Validate Staging and Prepare Warehouse"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{ACA3039B-930B-405B-9C38-1594EC75729F}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;IF NOT EXISTS (SELECT 1 FROM stg.Orders WHERE order_status NOT IN ('canceled','unavailable')) THROW 50300, 'No eligible orders in staging', 1;&#xA;IF NOT EXISTS (SELECT 1 FROM stg.Customers) OR NOT EXISTS (SELECT 1 FROM stg.Products) OR NOT EXISTS (SELECT 1 FROM stg.CategoryTranslation) OR NOT EXISTS (SELECT 1 FROM stg.Sellers) OR NOT EXISTS (SELECT 1 FROM stg.OrderItems) OR NOT EXISTS (SELECT 1 FROM stg.Payments) OR NOT EXISTS (SELECT 1 FROM stg.Reviews) THROW 50303, 'One or more staging inputs are empty', 1;&#xA;IF EXISTS (SELECT 1 FROM stg.OrderItems i LEFT JOIN stg.Orders o ON o.order_id=i.order_id WHERE o.order_id IS NULL) OR EXISTS (SELECT 1 FROM stg.Payments p LEFT JOIN stg.Orders o ON o.order_id=p.order_id WHERE o.order_id IS NULL) OR EXISTS (SELECT 1 FROM stg.Reviews r LEFT JOIN stg.Orders o ON o.order_id=r.order_id WHERE o.order_id IS NULL) THROW 50302, 'Staging contains an item, payment, or review without an order', 1;&#xA;IF EXISTS (SELECT 1 FROM stg.Orders o LEFT JOIN stg.Customers c ON c.customer_id=o.customer_id WHERE o.order_status NOT IN ('canceled','unavailable') AND EXISTS (SELECT 1 FROM stg.OrderItems i WHERE i.order_id=o.order_id) AND c.customer_id IS NULL) OR EXISTS (SELECT 1 FROM stg.OrderItems i JOIN stg.Orders o ON o.order_id=i.order_id LEFT JOIN stg.Products p ON p.product_id=i.product_id LEFT JOIN stg.Sellers s ON s.seller_id=i.seller_id WHERE o.order_status NOT IN ('canceled','unavailable') AND (p.product_id IS NULL OR s.seller_id IS NULL)) THROW 50301, 'Missing customer, product, or seller lookup; load aborted', 1;&#xA;DELETE FROM dbo.FactPayment; DELETE FROM dbo.FactSales; DELETE FROM dbo.FactOrder; DELETE FROM dbo.DimOrder; DELETE FROM dbo.DimPayment; DELETE FROM dbo.DimSeller; DELETE FROM dbo.DimProduct; DELETE FROM dbo.DimCustomer; DELETE FROM dbo.DimDate;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
