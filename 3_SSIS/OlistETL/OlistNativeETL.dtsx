                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CAST(x.[DateKey] AS int) AS [DateKey],CAST(x.[FullDate] AS date) AS [FullDate],CAST(x.[Year] AS smallint) AS [Year],CAST(x.[Quarter] AS tinyint) AS [Quarter],CAST(x.[Month] AS tinyint) AS [Month],CAST(x.[Day] AS tinyint) AS [Day],CAST(x.[MonthName] AS varchar(9)) AS [MonthName],CAST(x.[ISOWeekdayNo] AS tinyint) AS [ISOWeekdayNo],CAST(x.[ISOWeekdayName] AS varchar(9)) AS [ISOWeekdayName] FROM (SELECT CONVERT(int, CONVERT(char(8), d.dt, 112)), d.dt, YEAR(d.dt), DATEPART(quarter,d.dt), MONTH(d.dt), DAY(d.dt), CHOOSE(MONTH(d.dt),'January','February','March','April','May','June','July','August','September','October','November','December'), w.n, CHOOSE(w.n,'Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday') FROM (SELECT DATEADD(day,seq.n,b.firstdate) dt FROM (SELECT MIN(CAST(order_purchase_timestamp AS date)) firstdate, MAX(CAST(order_purchase_timestamp AS date)) lastdate FROM (SELECT o0.* FROM stg.Orders o0 WHERE o0.order_status NOT IN ('canceled','unavailable') AND EXISTS (SELECT 1 FROM stg.OrderItems i0 WHERE i0.order_id=o0.order_id)) AS eligible_orders) b CROSS APPLY (SELECT TOP (DATEDIFF(day,b.firstdate,b.lastdate)+1) CAST(ROW_NUMBER() OVER (ORDER BY (SELECT NULL))-1 AS int) n FROM sys.all_objects a CROSS JOIN sys.all_objects z) seq) d CROSS APPLY (SELECT ((DATEDIFF(day,CONVERT(date,'19000101'),d.dt) % 7 + 7) % 7)+1 n) w) AS x([DateKey],[FullDate],[Year],[Quarter],[Month],[Day],[MonthName],[ISOWeekdayNo],[ISOWeekdayName])</property>
