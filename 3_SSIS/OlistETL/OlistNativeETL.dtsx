                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CAST(x.[OrderKey] AS int) AS [OrderKey],CAST(x.[PaymentSequential] AS int) AS [PaymentSequential],CAST(x.[DateKey] AS int) AS [DateKey],CAST(x.[CustomerKey] AS int) AS [CustomerKey],CAST(x.[PaymentKey] AS int) AS [PaymentKey],CAST(x.[PaymentValue] AS decimal(19,2)) AS [PaymentValue],CAST(x.[PaymentInstallments] AS int) AS [PaymentInstallments] FROM (SELECT od.OrderKey,p.payment_sequential,CONVERT(int,CONVERT(char(8),o.order_purchase_timestamp,112)),c.CustomerKey,dp.PaymentKey,p.payment_value,p.payment_installments
        FROM (SELECT o0.* FROM stg.Orders o0 WHERE o0.order_status NOT IN ('canceled','unavailable') AND EXISTS (SELECT 1 FROM stg.OrderItems i0 WHERE i0.order_id=o0.order_id)) o JOIN stg.Payments p ON p.order_id=o.order_id JOIN dbo.DimOrder od ON od.OrderID=o.order_id
