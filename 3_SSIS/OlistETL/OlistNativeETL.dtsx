              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="FactOrder Source"
              usesDispositions="true"
              validateExternalMetadata="False"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[STA_OnlineRetail]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CAST(x.[OrderKey] AS int) AS [OrderKey],CAST(x.[DateKey] AS int) AS [DateKey],CAST(x.[CustomerKey] AS int) AS [CustomerKey],CAST(x.[ReviewID] AS char(32)) AS [ReviewID],CAST(x.[ReviewCreationDate] AS datetime2(7)) AS [ReviewCreationDate],CAST(x.[ReviewScore] AS tinyint) AS [ReviewScore],CAST(x.[ReviewPresent] AS bit) AS [ReviewPresent],CAST(x.[DeliveryDays] AS int) AS [DeliveryDays],CAST(x.[DeliveredFlag] AS bit) AS [DeliveredFlag],CAST(x.[LateFlag] AS bit) AS [LateFlag],CAST(x.[LateEligibleFlag] AS bit) AS [LateEligibleFlag] FROM (SELECT od.OrderKey,CONVERT(int,CONVERT(char(8),o.order_purchase_timestamp,112)),c.CustomerKey,r.review_id,r.review_creation_date,r.review_score,
          CASE WHEN r.review_id IS NULL THEN 0 ELSE 1 END,
          DATEDIFF(day,CAST(o.order_purchase_timestamp AS date),CAST(o.order_delivered_customer_date AS date)),
          CASE WHEN o.order_delivered_customer_date IS NULL THEN 0 ELSE 1 END,
          CASE WHEN o.order_delivered_customer_date IS NULL OR o.order_estimated_delivery_date IS NULL THEN NULL WHEN CAST(o.order_delivered_customer_date AS date)&gt;CAST(o.order_estimated_delivery_date AS date) THEN 1 ELSE 0 END,
          CASE WHEN o.order_delivered_customer_date IS NOT NULL AND o.order_estimated_delivery_date IS NOT NULL THEN 1 ELSE 0 END
        FROM (SELECT o0.* FROM stg.Orders o0 WHERE o0.order_status NOT IN ('canceled','unavailable') AND EXISTS (SELECT 1 FROM stg.OrderItems i0 WHERE i0.order_id=o0.order_id)) o JOIN dbo.DimOrder od ON od.OrderID=o.order_id JOIN dbo.DimCustomer c ON c.CustomerID=o.customer_id
        OUTER APPLY (SELECT TOP (1) review_id,review_creation_date,review_score FROM stg.Reviews r WHERE r.order_id=o.order_id ORDER BY review_creation_date DESC,review_answer_timestamp DESC,review_id DESC,review_score DESC) r) AS x([OrderKey],[DateKey],[CustomerKey],[ReviewID],[ReviewCreationDate],[ReviewScore],[ReviewPresent],[DeliveryDays],[DeliveredFlag],[LateFlag],[LateEligibleFlag])</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
