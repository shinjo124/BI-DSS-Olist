                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(Text.Combine({",
                "\"\"",
                "    }), BinaryEncoding.Base64), Compression.Deflate)),",
                "    Raw = Table.FromRows(Rows, {\"DateKey\", \"FullDate\", \"Year\", \"Quarter\", \"Month\", \"Day\", \"MonthName\", \"ISOWeekdayNo\", \"ISOWeekdayName\", \"YearMonth\", \"MonthLabel\"}),",
                "    Typed = Table.TransformColumnTypes(Raw, {{\"DateKey\", Int64.Type}, {\"FullDate\", type datetime}, {\"Year\", Int64.Type}, {\"Quarter\", Int64.Type}, {\"Month\", Int64.Type}, {\"Day\", Int64.Type}, {\"MonthName\", type text}, {\"ISOWeekdayNo\", Int64.Type}, {\"ISOWeekdayName\", type text}, {\"YearMonth\", Int64.Type}, {\"MonthLabel\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
