                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT p.payment_type AS PaymentType FROM stg.Payments AS p JOIN stg.Orders AS o ON o.order_id = p.order_id WHERE o.order_status NOT IN ('canceled','unavailable') AND EXISTS (SELECT 1 FROM stg.OrderItems AS i WHERE i.order_id = o.order_id) AND NOT EXISTS (SELECT 1 FROM dbo.DimPayment AS d WHERE d.PaymentType = p.payment_type)</property>
