                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[STA_OnlineRetail]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CAST(x.[CustomerID] AS char(32)) AS [CustomerID],CAST(x.[CustomerUniqueID] AS char(32)) AS [CustomerUniqueID],CAST(x.[City] AS nvarchar(100)) AS [City],CAST(x.[State] AS varchar(20)) AS [State],CAST(x.[Region] AS varchar(30)) AS [Region] FROM (SELECT c.customer_id,c.customer_unique_id,c.customer_city,c.customer_state,
          CASE WHEN c.customer_state IN ('AC','AP','AM','PA','RO','RR','TO') THEN 'Norte' WHEN c.customer_state IN ('AL','BA','CE','MA','PB','PE','PI','RN','SE') THEN 'Nordeste' WHEN c.customer_state IN ('DF','GO','MT','MS') THEN 'Centro-Oeste' WHEN c.customer_state IN ('ES','MG','RJ','SP') THEN 'Sudeste' WHEN c.customer_state IN ('PR','RS','SC') THEN 'Sul' ELSE 'Unknown' END
        FROM stg.Customers c WHERE EXISTS (SELECT 1 FROM (SELECT o0.* FROM stg.Orders o0 WHERE o0.order_status NOT IN ('canceled','unavailable') AND EXISTS (SELECT 1 FROM stg.OrderItems i0 WHERE i0.order_id=o0.order_id)) o WHERE o.customer_id=c.customer_id)) AS x([CustomerID],[CustomerUniqueID],[City],[State],[Region])</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
