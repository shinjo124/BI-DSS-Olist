      {
        "name": "FactSales",
        "columns": [
          {
            "name": "OrderKey",
            "sourceColumn": "OrderKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "OrderItemID",
            "sourceColumn": "OrderItemID",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "DateKey",
            "sourceColumn": "DateKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "CustomerKey",
            "sourceColumn": "CustomerKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "ProductKey",
            "sourceColumn": "ProductKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "SellerKey",
            "sourceColumn": "SellerKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Quantity",
            "sourceColumn": "Quantity",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Price",
            "sourceColumn": "Price",
            "dataType": "decimal",
            "summarizeBy": "none"
          },
          {
            "name": "FreightValue",
            "sourceColumn": "FreightValue",
            "dataType": "decimal",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM(FactSales[Price])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Item Quantity",
            "expression": "SUM(FactSales[Quantity])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Sales Orders",
            "expression": "DISTINCTCOUNT(FactSales[OrderKey])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE(CONVERT([Revenue], DOUBLE), [Sales Orders])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Freight Value",
            "expression": "SUM(FactSales[FreightValue])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q01 Revenue",
            "expression": "[Revenue]",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q01 Sales Orders",
            "expression": "[Sales Orders]",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Q02 Revenue",
            "expression": "VAR TopCategories = TOPN(10, ALLSELECTED(DimProduct[CategoryEnglish]), [Revenue], DESC, DimProduct[CategoryEnglish], ASC) RETURN CALCULATE([Revenue], KEEPFILTERS(TopCategories))",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q02 Item Quantity",
            "expression": "VAR TopCategories = TOPN(10, ALLSELECTED(DimProduct[CategoryEnglish]), [Revenue], DESC, DimProduct[CategoryEnglish], ASC) RETURN CALCULATE([Item Quantity], KEEPFILTERS(TopCategories))",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Q03 Revenue",
            "expression": "IF(RANKX(ALLSELECTED(DimCustomer[State]), [Revenue], , DESC) <= 5, [Revenue])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q03 Sales Orders",
            "expression": "IF(RANKX(ALLSELECTED(DimCustomer[State]), [Revenue], , DESC) <= 5, [Sales Orders])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Q03 Avg Order Value",
            "expression": "IF(RANKX(ALLSELECTED(DimCustomer[State]), [Revenue], , DESC) <= 5, [Avg Order Value])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q05 Revenue",
            "expression": "IF(SELECTEDVALUE(DimDate[Year]) = 2017, [Revenue])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q05 MoM Growth",
            "expression": "VAR Period = SELECTEDVALUE(DimDate[YearMonth]) VAR Prior = IF(MOD(Period,100)=1, Period-89, Period-1) VAR PreviousRevenue = CALCULATE([Revenue], REMOVEFILTERS(DimDate), DimDate[YearMonth]=Prior) RETURN IF(SELECTEDVALUE(DimDate[Year])=2017, DIVIDE(CONVERT([Revenue]-PreviousRevenue, DOUBLE), PreviousRevenue))",
            "formatString": "0.00%",
            "isHidden": false
          },
          {
            "name": "Q08 Revenue",
            "expression": "IF(RANKX(ALLSELECTED(DimSeller), [Revenue], [Revenue], DESC) <= 10, [Revenue])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q08 Matching Orders",
            "expression": "IF(RANKX(ALLSELECTED(DimSeller), [Revenue], [Revenue], DESC) <= 10, [Matching Orders])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Q08 Matching Avg Review",
            "expression": "IF(RANKX(ALLSELECTED(DimSeller), [Revenue], [Revenue], DESC) <= 10, [Matching Avg Review])",
            "formatString": "0.0000",
            "isHidden": false
          },
          {
            "name": "Q09 Revenue",
            "expression": "CALCULATE([Revenue], KEEPFILTERS(DimDate[Year] IN {2017,2018}), KEEPFILTERS(DimDate[Month]<=8))",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q09 Freight Value",
            "expression": "CALCULATE([Freight Value], KEEPFILTERS(DimDate[Year] IN {2017,2018}), KEEPFILTERS(DimDate[Month]<=8))",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q09 Freight Ratio",
            "expression": "DIVIDE(CONVERT([Q09 Freight Value], DOUBLE), [Q09 Revenue])",
            "formatString": "0.00%",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "FactSales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(Text.Combine({",
                "\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\"",
                "    }), BinaryEncoding.Base64), Compression.Deflate)),",
                "    Raw = Table.FromRows(Rows, {\"OrderKey\", \"OrderItemID\", \"DateKey\", \"CustomerKey\", \"ProductKey\", \"SellerKey\", \"Quantity\", \"Price\", \"FreightValue\"}),",
                "    Typed = Table.TransformColumnTypes(Raw, {{\"OrderKey\", Int64.Type}, {\"OrderItemID\", Int64.Type}, {\"DateKey\", Int64.Type}, {\"CustomerKey\", Int64.Type}, {\"ProductKey\", Int64.Type}, {\"SellerKey\", Int64.Type}, {\"Quantity\", Int64.Type}, {\"Price\", Currency.Type}, {\"FreightValue\", Currency.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "FactOrder",
        "columns": [
          {
            "name": "OrderKey",
            "sourceColumn": "OrderKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "DateKey",
            "sourceColumn": "DateKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "CustomerKey",
            "sourceColumn": "CustomerKey",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "ReviewScore",
            "sourceColumn": "ReviewScore",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "ReviewPresent",
            "sourceColumn": "ReviewPresent",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "DeliveryDays",
            "sourceColumn": "DeliveryDays",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "DeliveredFlag",
            "sourceColumn": "DeliveredFlag",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "LateFlag",
            "sourceColumn": "LateFlag",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "LateEligibleFlag",
            "sourceColumn": "LateEligibleFlag",
            "dataType": "int64",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Order Count",
            "expression": "COUNTROWS(FactOrder)",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Order Review Count",
            "expression": "COUNT(FactOrder[ReviewScore])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Order Avg Review",
            "expression": "AVERAGE(FactOrder[ReviewScore])",
            "formatString": "0.0000",
            "isHidden": false
          },
          {
            "name": "Matching Orders",
            "expression": "CALCULATE([Order Count], TREATAS(VALUES(FactSales[OrderKey]), FactOrder[OrderKey]))",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Matching Reviews",
            "expression": "CALCULATE([Order Review Count], TREATAS(VALUES(FactSales[OrderKey]), FactOrder[OrderKey]))",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Matching Avg Review",
            "expression": "CALCULATE([Order Avg Review], TREATAS(VALUES(FactSales[OrderKey]), FactOrder[OrderKey]))",
            "formatString": "0.0000",
            "isHidden": false
          },
          {
            "name": "Delivered Count",
            "expression": "SUM(FactOrder[DeliveredFlag])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Late Eligible Count",
            "expression": "SUM(FactOrder[LateEligibleFlag])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Avg Delivery Days",
            "expression": "DIVIDE(SUM(FactOrder[DeliveryDays]), [Delivered Count])",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Late Rate",
            "expression": "DIVIDE(SUM(FactOrder[LateFlag]), [Late Eligible Count])",
            "formatString": "0.00%",
            "isHidden": false
          },
          {
            "name": "Q06 Matching Avg Review",
            "expression": "IF([Matching Reviews] >= 100 && RANKX(FILTER(ALLSELECTED(DimProduct[CategoryEnglish]), [Matching Reviews] >= 100), [Matching Avg Review], , ASC) <= 10, [Matching Avg Review])",
            "formatString": "0.0000",
            "isHidden": false
          },
          {
            "name": "Q06 Matching Reviews",
            "expression": "IF([Matching Reviews] >= 100 && RANKX(FILTER(ALLSELECTED(DimProduct[CategoryEnglish]), [Matching Reviews] >= 100), [Matching Avg Review], , ASC) <= 10, [Matching Reviews])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Q06 Matching Orders",
            "expression": "IF([Matching Reviews] >= 100 && RANKX(FILTER(ALLSELECTED(DimProduct[CategoryEnglish]), [Matching Reviews] >= 100), [Matching Avg Review], , ASC) <= 10, [Matching Orders])",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Q07 Avg Delivery Days",
            "expression": "[Avg Delivery Days]",
            "formatString": "#,##0.00",
            "isHidden": false
          },
          {
            "name": "Q07 Late Rate",
            "expression": "[Late Rate]",
            "formatString": "0.00%",
            "isHidden": false
          },
          {
            "name": "Q07 Delivered Count",
            "expression": "[Delivered Count]",
            "formatString": "#,##0",
            "isHidden": false
          },
          {
            "name": "Q07 Late Eligible Count",
            "expression": "[Late Eligible Count]",
            "formatString": "#,##0",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "FactOrder",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(Text.Combine({",
                "\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\",\n\"\"",
                "    }), BinaryEncoding.Base64), Compression.Deflate)),",
                "    Raw = Table.FromRows(Rows, {\"OrderKey\", \"DateKey\", \"CustomerKey\", \"ReviewScore\", \"ReviewPresent\", \"DeliveryDays\", \"DeliveredFlag\", \"LateFlag\", \"LateEligibleFlag\"}),",
                "    Typed = Table.TransformColumnTypes(Raw, {{\"OrderKey\", Int64.Type}, {\"DateKey\", Int64.Type}, {\"CustomerKey\", Int64.Type}, {\"ReviewScore\", Int64.Type}, {\"ReviewPresent\", Int64.Type}, {\"DeliveryDays\", Int64.Type}, {\"DeliveredFlag\", Int64.Type}, {\"LateFlag\", Int64.Type}, {\"LateEligibleFlag\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
